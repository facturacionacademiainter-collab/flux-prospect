# Proyecto Supabase (Settings > API). La anon key es pública por diseño; RLS protege los datos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Mostrar el botón "Regenerar mensaje" (requiere desplegar la Edge Function regenerar-mensaje)
VITE_ENABLE_REGENERAR=false

# Solo para `npm run seed` (no se usan en el build)
SEED_EMAIL=mauro@ejemplo.com
SEED_PASSWORD=
